# --- Server ---
PORT=4000
# Set to "production" to enforce a strong JWT_SECRET and harden behaviour.
NODE_ENV=development
# Comma-separated list of allowed origins (leave empty to allow all in dev).
# In production set this to your app's origin(s) — do not leave open.
CORS_ORIGIN=

# --- Auth ---
# Use a long random string in production. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=30d

# --- Stripe ---
# Secret key from https://dashboard.stripe.com/apikeys (use test key: sk_test_...)
STRIPE_SECRET_KEY=sk_test_xxx
# Recurring Price ID for the monthly subscription (create a Product + monthly Price in Stripe)
STRIPE_PRICE_ID=price_xxx
# Webhook signing secret (from `stripe listen` or the Dashboard webhook config)
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Publishable key is consumed by the mobile app, but we expose it for convenience
STRIPE_PUBLISHABLE_KEY=pk_test_xxx
# Free trial length in days (0 = no trial). Drives signup conversion.
STRIPE_TRIAL_DAYS=7
# Human-readable price label shown on the paywall (₪)
SUBSCRIPTION_PRICE_LABEL=₪49 / חודש
